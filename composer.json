{
    "name": "softspring/doctrine-templates",
    "description": "This library provides doctrine templates",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "doctrine/orm": "^2.10 || ^3.0",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2",
        "symfony/form": "^6.4|^7.3",
        "symfony/intl": "^6.4|^7.3"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\DoctrineTemplates\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
